filters:
  and:
    - status == "Ongoing"
    - not:
        - file.inFolder("x_Archive")
    - not:
        - file.inFolder("Templates")
    - or:
        - file.hasTag("amazon")
        - file.hasTag("kbc")
        - file.hasTag("kirkham-law")
        - file.hasTag("personal")
properties:
  site_code:
    displayName: Site Code
  deal_type:
    displayName: Type
  business_unit:
    displayName: BU
  tm:
    displayName: TM
  matter_type:
    displayName: Matter Type
  client:
    displayName: Client
  office:
    displayName: Office
  local_broker:
    displayName: Local Broker
  launch_date:
    displayName: Launch Date
  last_updated:
    displayName: Last Updated
views:
  - type: table
    name: All Matters
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - last_updated
  - type: table
    name: Amazon
    filters:
      and:
        - file.hasTag("amazon")
    order:
      - file.name
      - site_code
      - deal_type
      - business_unit
      - tm
      - local_broker
      - launch_date
      - last_updated
    sort:
      - property: site_code
        direction: ASC
  - type: table
    name: KBC
    filters:
      and:
        - file.hasTag("kbc")
    order:
      - file.name
      - office
      - last_updated
  - type: table
    name: Kirkham Law
    filters:
      and:
        - file.hasTag("kirkham-law")
    order:
      - file.name
      - matter_type
      - client
      - last_updated
  - type: table
    name: Personal
    filters:
      and:
        - file.hasTag("personal")
    order:
      - file.name
      - last_updated

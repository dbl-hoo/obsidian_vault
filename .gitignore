# Sync and OS
.stfolder/
desktop.ini
Thumbs.db

# Obsidian workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Plugin data — all plugins (may contain credentials, tokens, sensitive state)
.obsidian/plugins/*/data.json

# Plugin compiled assets — large generated files, not source
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# obsidian-git credential helper
.obsidian/plugins/obsidian-git/obsidian_askpass.sh

# Graph layout — ephemeral UI state
.obsidian/graph.json

# Sync conflict files
*.sync-conflict-*
